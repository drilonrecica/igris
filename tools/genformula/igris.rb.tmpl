class Igris < Formula
  desc "Runs a project's task plan through Claude Code sessions in herdr, one task at a time"
  homepage "https://drilonrecica.github.io/igris/"
  version "{{.Version}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "{{.DarwinARM64.URL}}"
      sha256 "{{.DarwinARM64.SHA256}}"
    else
      url "{{.DarwinAMD64.URL}}"
      sha256 "{{.DarwinAMD64.SHA256}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "{{.LinuxARM64.URL}}"
      sha256 "{{.LinuxARM64.SHA256}}"
    else
      url "{{.LinuxAMD64.URL}}"
      sha256 "{{.LinuxAMD64.SHA256}}"
    end
  end

  def install
    bin.install "igris"
    generate_completions_from_executable(bin/"igris", "completion")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/igris version")
  end
end
