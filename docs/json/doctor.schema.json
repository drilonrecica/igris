{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "igris doctor --json",
  "description": "The health checks, in their one order (SPEC §14).",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Document version. Changes only with a breaking change (igris 2.0); fields may be added in 1.x, and readers ignore fields they don't know."
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "required": [
    "v",
    "checks"
  ],
  "$defs": {
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "ok",
            "warn",
            "fail"
          ]
        },
        "message": {
          "type": "string"
        },
        "next": {
          "type": "string",
          "description": "The command that fixes the problem."
        },
        "confirm": {
          "type": "boolean",
          "description": "A run starts only after the owner confirms."
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "task": {
          "type": "string",
          "description": "A drifted task."
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "level",
        "message"
      ]
    }
  }
}
