{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "igris usage --json",
  "description": "Token usage and the rank audit of one run or of the runs since a time (SPEC §14). Tokens recorded in the session transcripts, never a cost.",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Document version. Changes only with a breaking change (igris 2.0); fields may be added in 1.x, and readers ignore fields they don't know."
    },
    "runs": {
      "type": "array",
      "description": "The runs covered, oldest first.",
      "items": {
        "type": "object",
        "properties": {
          "run": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "description": "As report's end."
          }
        },
        "required": [
          "started_at",
          "end"
        ]
      }
    },
    "totals": {
      "$ref": "#/$defs/row"
    },
    "unavailable": {
      "type": "integer",
      "minimum": 0,
      "description": "Attempts whose usage could not be read; left out of the totals."
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "ranks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rank"
      }
    },
    "top": {
      "type": "array",
      "description": "The top 5 tasks by in + out.",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "audit": {
      "type": "object",
      "description": "The rank audit over the attempts covered, in attempts.",
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "unchecked": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "mismatch": {
          "type": "integer",
          "minimum": 0
        },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run": {
                "type": "string"
              },
              "task": {
                "type": "string"
              },
              "rank": {
                "type": "string"
              },
              "model": {
                "type": "string",
                "description": "What the rank resolved to."
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "What the main thread ran on."
              }
            },
            "required": [
              "task",
              "models"
            ]
          }
        }
      },
      "required": [
        "ok",
        "unchecked",
        "unavailable",
        "mismatch",
        "mismatches"
      ]
    },
    "side": {
      "type": "array",
      "description": "Side sessions (SPEC §6.10) that ended in the runs covered (a side_usage line with that run), or with --since by time. Their own list: they are no attempt and in none of the figures above. Since 1.2.",
      "items": {
        "$ref": "#/$defs/side"
      }
    },
    "note": {
      "type": "string",
      "description": "Lines of runs.jsonl that could not be used, or come from a newer igris."
    },
    "no_usage": {
      "type": "string",
      "description": "Present only when no attempt of the runs covered logged usage: why (made before 1.1, or [usage] enabled = false). The zeros are then not a measurement."
    },
    "quota": {
      "type": [
        "object",
        "null"
      ],
      "description": "The subscription quota igris's status line last recorded (needs [usage] statusline = true, SPEC §6.3); null when none was. The age is at. Not a cost.",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "When it was recorded."
        },
        "five_hour": {
          "type": "object",
          "description": "One subscription rate-limit window.",
          "properties": {
            "used": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Percent of the window used."
            },
            "resets_at": {
              "type": "integer",
              "description": "When the window resets, Unix seconds."
            }
          },
          "required": [
            "used",
            "resets_at"
          ]
        },
        "seven_day": {
          "type": "object",
          "description": "One subscription rate-limit window.",
          "properties": {
            "used": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Percent of the window used."
            },
            "resets_at": {
              "type": "integer",
              "description": "When the window resets, Unix seconds."
            }
          },
          "required": [
            "used",
            "resets_at"
          ]
        }
      },
      "required": [
        "at"
      ]
    },
    "budgets": {
      "type": "array",
      "description": "Since 1.8: the budgets of each run covered with what it used of them (SPEC §6.9), oldest run first; absent when igris.toml sets none and no run reached one.",
      "items": {
        "$ref": "#/$defs/budget"
      }
    }
  },
  "required": [
    "v",
    "runs",
    "totals",
    "unavailable",
    "tasks",
    "models",
    "ranks",
    "top",
    "audit"
  ],
  "$defs": {
    "tokens": {
      "type": "object",
      "description": "Summed token counts as recorded in the session transcripts.",
      "properties": {
        "in": {
          "type": "integer",
          "minimum": 0,
          "description": "Input + cache read + cache write."
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "in",
        "output",
        "input",
        "cache_read",
        "cache_write",
        "messages"
      ]
    },
    "row": {
      "type": "object",
      "description": "Usage of an item over the attempts whose usage could be read. The tokens include the subagents', `sub` is their part.",
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "in": {
          "type": "integer",
          "minimum": 0,
          "description": "Input + cache read + cache write."
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "sub": {
          "$ref": "#/$defs/tokens"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        }
      },
      "required": [
        "attempts",
        "in",
        "output",
        "input",
        "cache_read",
        "cache_write",
        "messages",
        "sub",
        "estimate"
      ]
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "rank": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "description": "The model the rank resolved to."
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "in": {
          "type": "integer",
          "minimum": 0,
          "description": "Input + cache read + cache write."
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "sub": {
          "$ref": "#/$defs/tokens"
        },
        "unavailable": {
          "type": "integer",
          "minimum": 1,
          "description": "Attempts whose usage could not be read."
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Model ids the main thread ran on."
        },
        "sub_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Model ids the subagents ran on."
        },
        "audit": {
          "enum": [
            "ok",
            "unchecked",
            "unavailable",
            "mismatch"
          ],
          "description": "The worst audit of the task's attempts."
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        }
      },
      "required": [
        "id",
        "models",
        "attempts",
        "in",
        "output",
        "input",
        "cache_read",
        "cache_write",
        "messages",
        "sub",
        "estimate"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "The model ids an attempt's thread ran on, joined with \", \"; unknown without one."
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "in": {
          "type": "integer",
          "minimum": 0,
          "description": "Input + cache read + cache write."
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "sub": {
          "$ref": "#/$defs/tokens"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        }
      },
      "required": [
        "model",
        "attempts",
        "in",
        "output",
        "input",
        "cache_read",
        "cache_write",
        "messages",
        "sub",
        "estimate"
      ]
    },
    "rank": {
      "type": "object",
      "properties": {
        "rank": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "in": {
          "type": "integer",
          "minimum": 0,
          "description": "Input + cache read + cache write."
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "sub": {
          "$ref": "#/$defs/tokens"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        }
      },
      "required": [
        "rank",
        "attempts",
        "in",
        "output",
        "input",
        "cache_read",
        "cache_write",
        "messages",
        "sub",
        "estimate"
      ]
    },
    "side": {
      "type": "object",
      "description": "One side session's usage as read from its transcript when it ended.",
      "properties": {
        "side": {
          "type": "string",
          "description": "The side session's ID."
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "When it ended."
        },
        "run": {
          "type": "string",
          "description": "The run the igris that logged it was running, absent when it had none."
        },
        "rank": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "description": "The model the rank resolved to when it was opened."
        },
        "unavailable": {
          "const": true,
          "description": "Its transcript could not be read; the counts are then zero."
        },
        "in": {
          "type": "integer",
          "minimum": 0,
          "description": "Input + cache read + cache write."
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "sub": {
          "$ref": "#/$defs/tokens"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Model ids its main thread ran on."
        },
        "sub_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Model ids its subagents ran on."
        }
      },
      "required": [
        "side",
        "at",
        "in",
        "output",
        "input",
        "cache_read",
        "cache_write",
        "messages",
        "sub",
        "models"
      ]
    },
    "estimate": {
      "type": "object",
      "description": "Since 1.8: the price estimate of the tokens at API list prices (SPEC §6.9): never a bill. `unpriced` counts the input + output tokens of attempts on a model without a price, which `usd` leaves out.",
      "properties": {
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "as_of": {
          "type": "string",
          "description": "The date of the embedded price table."
        },
        "source": {
          "enum": [
            "embedded",
            "config"
          ],
          "description": "`config` when an entry of [usage.prices] priced some of the tokens."
        },
        "unpriced": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "usd",
        "as_of",
        "source",
        "unpriced"
      ]
    },
    "budget": {
      "type": "object",
      "description": "Since 1.8: a budget of a run and what the run used of it (SPEC §6.9): the budgets igris.toml sets now, and any the run's log says it reached or raised.",
      "properties": {
        "run": {
          "type": "string",
          "description": "The run ID; absent in `report`, which is one run."
        },
        "budget": {
          "type": "string",
          "description": "run, phase:<id> or rank:<rank>."
        },
        "limit": {
          "type": "string",
          "description": "The value as igris.toml writes it (20M, $40), or as the run last raised it."
        },
        "used": {
          "type": "string",
          "description": "What the run used: a token count (14.2M; input + output, subagents included) or an estimate ($12.40) for an amount."
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "description": "used of limit; may pass 100."
        },
        "reached": {
          "type": "boolean",
          "description": "The run reached it (budget_exceeded)."
        },
        "raised": {
          "type": "string",
          "description": "The owner's last answer once reached (budget_raised): a new value, or continue."
        }
      },
      "required": [
        "budget",
        "limit",
        "used",
        "percent"
      ]
    }
  }
}
