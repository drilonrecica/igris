{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "igris report --json",
  "description": "One run in detail (SPEC §14). Values the log doesn't record are absent.",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Document version. Changes only with a breaking change (igris 2.0); fields may be added in 1.x, and readers ignore fields they don't know."
    },
    "run": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "description": "RFC 3339, UTC.",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "description": "RFC 3339, UTC.",
      "format": "date-time"
    },
    "duration_s": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "string",
      "description": "How the run ended: the engine's outcome (completed, stuck, stopped, error), interrupted (no stop recorded) or running."
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "done": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "unfinished": {
      "type": "integer",
      "minimum": 0
    },
    "needs_you_s": {
      "type": "integer",
      "minimum": 0
    },
    "commits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commit"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "v",
    "started_at",
    "end",
    "phases",
    "done",
    "skipped",
    "unfinished",
    "commits",
    "errors",
    "tasks"
  ],
  "$defs": {
    "selection": {
      "description": "The slice of a sliced run (SPEC §5.5).",
      "type": "object",
      "properties": {
        "only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "from": {
          "type": "string"
        },
        "until": {
          "type": "string"
        }
      },
      "required": []
    },
    "commit": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        },
        "sha": {
          "type": "string",
          "description": "Full SHA."
        },
        "subject": {
          "type": "string"
        }
      },
      "required": []
    },
    "verify": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "passed"
      ]
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "enum": [
            "agent",
            "user",
            "agent + user"
          ]
        },
        "rank": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "description": "How the task ended in the run.",
          "enum": [
            "done",
            "skipped",
            "unfinished",
            "running"
          ]
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "verify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verify"
          }
        },
        "commit": {
          "type": "string",
          "description": "Full SHA of the task's last commit."
        },
        "note": {
          "type": "string"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Claude session UUIDs, in order."
        },
        "resume": {
          "type": "string"
        },
        "needs_you_s": {
          "type": "integer",
          "minimum": 0
        },
        "audit": {
          "enum": [
            "ok",
            "mismatch",
            "unchecked",
            "unavailable"
          ],
          "description": "Since 1.1: the rank audit over the task's attempts (SPEC §6.9), its worst result; absent when the log has none."
        },
        "usage": {
          "$ref": "#/$defs/tokens",
          "description": "Since 1.1: the tokens of the task's attempts whose usage was read, subagents included; absent when none was."
        },
        "sub": {
          "$ref": "#/$defs/tokens",
          "description": "Since 1.1: the subagents' part of usage; absent when there were none."
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Since 1.1: the main thread's model ids; absent when no usage was read."
        }
      },
      "required": [
        "id",
        "result",
        "verify",
        "sessions"
      ]
    },
    "tokens": {
      "type": "object",
      "description": "Summed token counts as recorded in the session transcripts.",
      "properties": {
        "in": {
          "type": "integer",
          "minimum": 0,
          "description": "Input + cache read + cache write."
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "in",
        "output",
        "input",
        "cache_read",
        "cache_write",
        "messages"
      ]
    }
  }
}
