{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "igris report --json",
  "description": "One run in detail (SPEC §14). Values the log doesn't record are absent.",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Document version. Changes only with a breaking change (igris 2.0); fields may be added in 1.x, and readers ignore fields they don't know."
    },
    "run": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "description": "RFC 3339, UTC.",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "description": "RFC 3339, UTC.",
      "format": "date-time"
    },
    "duration_s": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "string",
      "description": "How the run ended: the engine's outcome (completed, stuck, stopped, error), interrupted (no stop recorded) or running."
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "done": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "unfinished": {
      "type": "integer",
      "minimum": 0
    },
    "needs_you_s": {
      "type": "integer",
      "minimum": 0
    },
    "commits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commit"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "note": {
      "type": "string"
    },
    "time": {
      "$ref": "#/$defs/time_breakdown"
    },
    "estimate": {
      "$ref": "#/$defs/estimate",
      "description": "Since 1.8: the price estimate of the run's tokens (SPEC §6.9); absent when no usage was read."
    },
    "budgets": {
      "type": "array",
      "description": "Since 1.8: the run's budgets with what it used of them (SPEC §6.9); absent when igris.toml sets none and the run reached none.",
      "items": {
        "$ref": "#/$defs/budget"
      }
    }
  },
  "required": [
    "v",
    "started_at",
    "end",
    "phases",
    "done",
    "skipped",
    "unfinished",
    "commits",
    "errors",
    "tasks"
  ],
  "$defs": {
    "selection": {
      "description": "The slice of a sliced run (SPEC §5.5).",
      "type": "object",
      "properties": {
        "only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "from": {
          "type": "string"
        },
        "until": {
          "type": "string"
        }
      },
      "required": []
    },
    "commit": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        },
        "sha": {
          "type": "string",
          "description": "Full SHA."
        },
        "subject": {
          "type": "string"
        }
      },
      "required": []
    },
    "verify": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "passed"
      ]
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "enum": [
            "agent",
            "user",
            "agent + user"
          ]
        },
        "rank": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "description": "How the task ended in the run.",
          "enum": [
            "done",
            "skipped",
            "unfinished",
            "running"
          ]
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "verify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verify"
          }
        },
        "commit": {
          "type": "string",
          "description": "Full SHA of the task's last commit."
        },
        "note": {
          "type": "string"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Claude session UUIDs, in order."
        },
        "resume": {
          "type": "string"
        },
        "needs_you_s": {
          "type": "integer",
          "minimum": 0
        },
        "audit": {
          "enum": [
            "ok",
            "mismatch",
            "unchecked",
            "unavailable"
          ],
          "description": "Since 1.1: the rank audit over the task's attempts (SPEC §6.9), its worst result; absent when the log has none."
        },
        "usage": {
          "$ref": "#/$defs/tokens",
          "description": "Since 1.1: the tokens of the task's attempts whose usage was read, subagents included; absent when none was."
        },
        "sub": {
          "$ref": "#/$defs/tokens",
          "description": "Since 1.1: the subagents' part of usage; absent when there were none."
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Since 1.1: the main thread's model ids; absent when no usage was read."
        },
        "time": {
          "$ref": "#/$defs/times",
          "description": "Since 1.8: the task's time by what it was spent on (SPEC §14): each instant once, in the first of needs you, limit wait, verify and agent it is in; absent for a v0 run and a user task."
        },
        "estimate": {
          "$ref": "#/$defs/estimate",
          "description": "Since 1.8: the price estimate of `usage`; absent without it."
        }
      },
      "required": [
        "id",
        "result",
        "verify",
        "sessions"
      ]
    },
    "tokens": {
      "type": "object",
      "description": "Summed token counts as recorded in the session transcripts.",
      "properties": {
        "in": {
          "type": "integer",
          "minimum": 0,
          "description": "Input + cache read + cache write."
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "in",
        "output",
        "input",
        "cache_read",
        "cache_write",
        "messages"
      ]
    },
    "times": {
      "type": "object",
      "description": "Seconds by what the time was spent on.",
      "properties": {
        "agent_s": {
          "type": "integer",
          "minimum": 0,
          "description": "The rest of the time: the task's sessions at work, resolver sessions included."
        },
        "verify_s": {
          "type": "integer",
          "minimum": 0,
          "description": "The verify command running, outside the waits."
        },
        "needs_you_s": {
          "type": "integer",
          "minimum": 0,
          "description": "igris waiting on the owner."
        },
        "limit_s": {
          "type": "integer",
          "minimum": 0,
          "description": "A session waiting for a usage limit to reset, outside a needs-you wait."
        }
      },
      "required": [
        "agent_s",
        "verify_s",
        "needs_you_s",
        "limit_s"
      ]
    },
    "time_group": {
      "type": "object",
      "description": "The time of a set of agent tasks (the run's, a phase's or a rank's): agent_s … limit_s summed over the tasks, so tasks running side by side in a parallel phase each count; wall the time at least one of them spent on each; wall_s the time at least one of them ran.",
      "properties": {
        "phase": {
          "type": "string"
        },
        "rank": {
          "type": "string"
        },
        "agent_s": {
          "type": "integer",
          "minimum": 0,
          "description": "The rest of the time: the task's sessions at work, resolver sessions included."
        },
        "verify_s": {
          "type": "integer",
          "minimum": 0,
          "description": "The verify command running, outside the waits."
        },
        "needs_you_s": {
          "type": "integer",
          "minimum": 0,
          "description": "igris waiting on the owner."
        },
        "limit_s": {
          "type": "integer",
          "minimum": 0,
          "description": "A session waiting for a usage limit to reset, outside a needs-you wait."
        },
        "wall_s": {
          "type": "integer",
          "minimum": 0
        },
        "wall": {
          "$ref": "#/$defs/times"
        }
      },
      "required": [
        "agent_s",
        "verify_s",
        "needs_you_s",
        "limit_s",
        "wall_s",
        "wall"
      ]
    },
    "time_breakdown": {
      "type": "object",
      "description": "Since 1.8: the run's time by what it was spent on (SPEC §14), for its agent tasks; absent for a v0 run and a run without an agent task. A wait on the owner of no task is in the run's needs_you_s only.",
      "properties": {
        "run": {
          "$ref": "#/$defs/time_group"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_group"
          },
          "description": "Each phase, in log order."
        },
        "ranks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_group"
          },
          "description": "Each rank, in order of first start."
        }
      },
      "required": [
        "run",
        "phases",
        "ranks"
      ]
    },
    "estimate": {
      "type": "object",
      "description": "Since 1.8: the price estimate of the tokens at API list prices (SPEC §6.9): never a bill. `unpriced` counts the input + output tokens of attempts on a model without a price, which `usd` leaves out.",
      "properties": {
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "as_of": {
          "type": "string",
          "description": "The date of the embedded price table."
        },
        "source": {
          "enum": [
            "embedded",
            "config"
          ],
          "description": "`config` when an entry of [usage.prices] priced some of the tokens."
        },
        "unpriced": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "usd",
        "as_of",
        "source",
        "unpriced"
      ]
    },
    "budget": {
      "type": "object",
      "description": "Since 1.8: a budget of a run and what the run used of it (SPEC §6.9): the budgets igris.toml sets now, and any the run's log says it reached or raised.",
      "properties": {
        "run": {
          "type": "string",
          "description": "The run ID; absent in `report`, which is one run."
        },
        "budget": {
          "type": "string",
          "description": "run, phase:<id> or rank:<rank>."
        },
        "limit": {
          "type": "string",
          "description": "The value as igris.toml writes it (20M, $40), or as the run last raised it."
        },
        "used": {
          "type": "string",
          "description": "What the run used: a token count (14.2M; input + output, subagents included) or an estimate ($12.40) for an amount."
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "description": "used of limit; may pass 100."
        },
        "reached": {
          "type": "boolean",
          "description": "The run reached it (budget_exceeded)."
        },
        "raised": {
          "type": "string",
          "description": "The owner's last answer once reached (budget_raised): a new value, or continue."
        }
      },
      "required": [
        "budget",
        "limit",
        "used",
        "percent"
      ]
    }
  }
}
