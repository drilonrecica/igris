{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "igris phases --json",
  "description": "The plan's phases with task counts per status.",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Document version. Changes only with a breaking change (igris 2.0); fields may be added in 1.x, and readers ignore fields they don't know."
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "plan": {
      "type": "string"
    }
  },
  "required": [
    "v",
    "phases",
    "plan"
  ],
  "$defs": {
    "counts": {
      "description": "Tasks per status.",
      "type": "object",
      "properties": {
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "in_progress": {
          "type": "integer",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ready",
        "blocked",
        "in_progress",
        "done",
        "skipped"
      ]
    },
    "phase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tasks."
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "parallelism": {
          "$ref": "#/$defs/parallelism"
        }
      },
      "required": [
        "id",
        "title",
        "total",
        "counts"
      ]
    },
    "parallelism": {
      "description": "How much of the phase's remaining work could run at once, over its unfinished tasks and the dependencies between them. Read-only: igris runs one task at a time. Added in 1.1; absent from older output.",
      "type": "object",
      "properties": {
        "critical_path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The longest chain of unfinished tasks, each depending on the one before it, in order. Empty when nothing is left."
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "description": "The most tasks that could run together (the widest level of the dependency graph); 0 when nothing is left."
        },
        "together": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Per level with two or more tasks, the IDs that would run together once the level before it is done, in file order."
        }
      },
      "required": [
        "critical_path",
        "width",
        "together"
      ]
    }
  }
}
