{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "igris phases --json",
  "description": "The plan's phases with task counts per status.",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Document version. Changes only with a breaking change (igris 2.0); fields may be added in 1.x, and readers ignore fields they don't know."
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "plan": {
      "type": "string"
    }
  },
  "required": [
    "v",
    "phases",
    "plan"
  ],
  "$defs": {
    "counts": {
      "description": "Tasks per status.",
      "type": "object",
      "properties": {
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "in_progress": {
          "type": "integer",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ready",
        "blocked",
        "in_progress",
        "done",
        "skipped"
      ]
    },
    "phase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tasks."
        },
        "counts": {
          "$ref": "#/$defs/counts"
        }
      },
      "required": [
        "id",
        "title",
        "total",
        "counts"
      ]
    }
  }
}
