{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "igris history TASK-ID --json",
  "description": "Every attempt of one task across all runs, newest first.",
  "type": "object",
  "properties": {
    "v": {
      "const": 1,
      "description": "Document version. Changes only with a breaking change (igris 2.0); fields may be added in 1.x, and readers ignore fields they don't know."
    },
    "task": {
      "type": "string"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "v",
    "task",
    "attempts"
  ],
  "$defs": {
    "attempt": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string"
        },
        "run_started_at": {
          "type": "string",
          "description": "RFC 3339, UTC.",
          "format": "date-time"
        },
        "started_at": {
          "type": "string",
          "description": "RFC 3339, UTC.",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "description": "RFC 3339, UTC.",
          "format": "date-time"
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        },
        "rank": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "description": "How the task ended in the run.",
          "enum": [
            "done",
            "skipped",
            "unfinished",
            "running"
          ]
        },
        "note": {
          "type": "string",
          "description": "The done note or skip reason."
        },
        "verify": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "One line per verify result."
        }
      },
      "required": [
        "run_started_at",
        "result",
        "verify"
      ]
    }
  }
}
