{
  "name": "igris",
  "displayName": "Igris",
  "description": "Watch and steer an igris run from the editor: the plan's phases and tasks, what needs you, and what each task changed.",
  "version": "1.9.0",
  "publisher": "drilonrecica",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/drilonrecica/igris.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/drilonrecica/igris",
  "bugs": {
    "url": "https://github.com/drilonrecica/igris/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "igris",
    "claude code",
    "task plan",
    "agents"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.igris/igris.sock",
    "workspaceContains:igris.toml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "igris",
          "title": "Igris",
          "icon": "resources/igris.svg"
        }
      ]
    },
    "views": {
      "igris": [
        {
          "id": "igris.run",
          "name": "Run",
          "icon": "resources/igris.svg",
          "contextualTitle": "Igris"
        }
      ]
    },
    "commands": [
      {
        "command": "igris.checkInstall",
        "title": "Igris: Check the igris install"
      },
      {
        "command": "igris.refresh",
        "title": "Igris: Refresh the run view",
        "icon": "$(refresh)"
      },
      {
        "command": "igris.showRun",
        "title": "Igris: Show what needs you"
      },
      {
        "command": "igris.answer",
        "title": "Igris: Answer what needs you",
        "icon": "$(bell-dot)"
      },
      {
        "command": "igris.taskActions",
        "title": "Igris: Task actions…"
      },
      {
        "command": "igris.runActions",
        "title": "Igris: Run actions…"
      },
      {
        "command": "igris.pause",
        "title": "Igris: Pause after this task",
        "icon": "$(debug-pause)"
      },
      {
        "command": "igris.resume",
        "title": "Igris: Resume",
        "icon": "$(debug-continue)"
      },
      {
        "command": "igris.stop",
        "title": "Igris: Stop the run",
        "icon": "$(debug-stop)"
      },
      {
        "command": "igris.startAnyway",
        "title": "Igris: Start anyway (usage hold)"
      },
      {
        "command": "igris.setMode",
        "title": "Igris: Mode of the next sessions…"
      },
      {
        "command": "igris.setTaskMode",
        "title": "Igris: Mode of this task's next session…"
      },
      {
        "command": "igris.viewChanges",
        "title": "Igris: Read a task's changes"
      },
      {
        "command": "igris.runTask",
        "title": "Igris: Run this task alone"
      },
      {
        "command": "igris.onboarding",
        "title": "Igris: Set up (first-run checklist)"
      },
      {
        "command": "igris.createPlan",
        "title": "Igris: Create a starter plan…"
      },
      {
        "command": "igris.startRun",
        "title": "Igris: Start a run…",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "igris.answer",
          "when": "view == igris.run && igris.needs",
          "group": "navigation@0"
        },
        {
          "command": "igris.refresh",
          "when": "view == igris.run",
          "group": "navigation@9"
        },
        {
          "command": "igris.startRun",
          "when": "view == igris.run && igris.project && !igris.live && !igris.refused",
          "group": "navigation@1"
        },
        {
          "command": "igris.pause",
          "when": "view == igris.run && igris.live && !igris.paused",
          "group": "run@1"
        },
        {
          "command": "igris.resume",
          "when": "view == igris.run && igris.live && igris.paused",
          "group": "run@1"
        },
        {
          "command": "igris.startAnyway",
          "when": "view == igris.run && igris.live && igris.limited",
          "group": "run@2"
        },
        {
          "command": "igris.setMode",
          "when": "view == igris.run && igris.live",
          "group": "run@3"
        },
        {
          "command": "igris.stop",
          "when": "view == igris.run && igris.live",
          "group": "run@9"
        }
      ],
      "view/item/context": [
        {
          "command": "igris.answer",
          "when": "view == igris.run && viewItem =~ /\\.ask\\b/",
          "group": "inline"
        },
        {
          "command": "igris.answer",
          "when": "view == igris.run && viewItem =~ /\\.ask\\b/",
          "group": "1_answer@1"
        },
        {
          "command": "igris.taskActions",
          "when": "view == igris.run && igris.live && viewItem =~ /^igris\\.active/",
          "group": "1_answer@2"
        },
        {
          "command": "igris.setTaskMode",
          "when": "view == igris.run && viewItem =~ /\\.mode\\b/",
          "group": "2_mode@1"
        },
        {
          "command": "igris.pause",
          "when": "view == igris.run && viewItem =~ /^igris\\.run/ && igris.live && !igris.paused",
          "group": "3_run@1"
        },
        {
          "command": "igris.resume",
          "when": "view == igris.run && viewItem =~ /^igris\\.run/ && igris.live && igris.paused",
          "group": "3_run@1"
        },
        {
          "command": "igris.startAnyway",
          "when": "view == igris.run && viewItem =~ /^igris\\.run/ && igris.limited",
          "group": "3_run@2"
        },
        {
          "command": "igris.setMode",
          "when": "view == igris.run && viewItem =~ /^igris\\.run/ && igris.live",
          "group": "3_run@3"
        },
        {
          "command": "igris.stop",
          "when": "view == igris.run && viewItem =~ /^igris\\.run/ && igris.live",
          "group": "3_run@9"
        },
        {
          "command": "igris.viewChanges",
          "when": "view == igris.run && viewItem =~ /^igris\\.(task|active|question)/",
          "group": "1_answer@3"
        },
        {
          "command": "igris.viewChanges",
          "when": "view == igris.run && viewItem =~ /^igris\\.question/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "igris.answer",
          "when": "igris.needs"
        },
        {
          "command": "igris.taskActions",
          "when": "false"
        },
        {
          "command": "igris.setTaskMode",
          "when": "false"
        },
        {
          "command": "igris.runActions",
          "when": "igris.live"
        },
        {
          "command": "igris.pause",
          "when": "igris.live && !igris.paused"
        },
        {
          "command": "igris.resume",
          "when": "igris.live && igris.paused"
        },
        {
          "command": "igris.startAnyway",
          "when": "igris.live && igris.limited"
        },
        {
          "command": "igris.setMode",
          "when": "igris.live"
        },
        {
          "command": "igris.stop",
          "when": "igris.live"
        },
        {
          "command": "igris.viewChanges",
          "when": "igris.live || igris.needs"
        },
        {
          "command": "igris.runTask",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "igris.run",
        "contents": "The igris in PATH is missing or older than this extension needs; the checklist says which version to install.\n[Set up igris](command:igris.onboarding)",
        "when": "igris.refused"
      },
      {
        "view": "igris.run",
        "contents": "This folder is not an igris project yet. The checklist checks igris, Claude Code and tmux, then runs igris init here.\n[Set up igris](command:igris.onboarding)",
        "when": "!igris.refused && !igris.project"
      },
      {
        "view": "igris.run",
        "contents": "This project has no plan yet. A starter plan gives you phases and tasks to edit.\n[Create a starter plan](command:igris.createPlan)",
        "when": "igris.project && igris.noPlan && !igris.refused"
      },
      {
        "view": "igris.run",
        "contents": "No run is attached.\n[Start a run](command:igris.startRun)",
        "when": "igris.project && !igris.live && !igris.noPlan && !igris.refused"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:tests": "node esbuild.mjs --tests",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:tests && mocha --config .mocharc.json",
    "test:vscode": "npm run build && npm run build:tests && node out/test/vscode/runTest.js",
    "package": "sh scripts/vsix.sh"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "mocha": "12.0.3",
    "ovsx": "1.3.0",
    "typescript": "5.9.3"
  }
}
