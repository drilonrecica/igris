PROBLEMS
  ! warn  notify.webhook.url uses http://, so the payload (and its signature) go unencrypted; use an https:// URL

plan              = "tasks.md" · default
backend           = "auto" · default
default_mode      = "auto" · default
needs_input_after = "30s" · default
waiting_limit     = "30m" · default
nudge             = true · default
poll_interval     = "2s" · default

[models]
fable  = "fable" · default
haiku  = "haiku" · default
opus   = "opus" · default
sonnet = "sonnet" · default

[columns]
"Depends on" = "Deps"

[claude]
extra_args = [] · default

[run]
verify              = "make test"
verify_timeout      = "15m0s" · default
verify_max_attempts = 3 · default
commit              = "ask" · default
