#compdef igris
# zsh completion for igris. Load it with:  source <(igris completion zsh)
_igris() {
    local cmd prev
    if (( CURRENT == 2 )); then
        compadd -- init doctor check phases status history report usage arise serve attach stop done skip reset notify config adapt draft update completion help version
        return
    fi
    cmd=$words[2]
    prev=$words[CURRENT-1]
    case "$cmd:$prev" in
        init:--template) compadd -- go-cli library web-app ; return ;;
        check:--plan) _files ; return ;;
        phases:--plan) _files ; return ;;
        status:--plan) _files ; return ;;
        history:-n) return ;;
        usage:--since) return ;;
        arise:--from) compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ; return ;;
        arise:--mode) compadd -- default accept auto plan yolo manual plan:default plan:accept plan:auto plan:yolo ; return ;;
        arise:--only) compset -P '*,' ; compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ; return ;;
        arise:--parallel) return ;;
        arise:--through) compadd -- ${(f)"$(igris __complete phases 2>/dev/null)"} ; return ;;
        arise:--until) compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ; return ;;
        serve:--from) compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ; return ;;
        serve:--mode) compadd -- default accept auto plan yolo manual plan:default plan:accept plan:auto plan:yolo ; return ;;
        serve:--only) compset -P '*,' ; compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ; return ;;
        serve:--parallel) return ;;
        serve:--through) compadd -- ${(f)"$(igris __complete phases 2>/dev/null)"} ; return ;;
        serve:--until) compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ; return ;;
        done:--note) return ;;
        skip:--reason) return ;;
        notify:--event) compadd -- needs_input session_lost task_overdue rank_mismatch verify_failed_limit task_done phase_done phase_stuck run_error ; return ;;
        adapt:--model) compadd -- sonnet opus ; return ;;
        adapt:--plan) _files ; return ;;
        draft:--format) compadd -- github linear jira ; return ;;
        draft:--model) compadd -- sonnet opus ; return ;;
        draft:--plan) _files ; return ;;
    esac
    if [[ $PREFIX == -* ]]; then
        case "$cmd" in
            init) compadd -- --example --template ;;
            doctor) compadd -- --json ;;
            check) compadd -- --json --plan --strict ;;
            phases) compadd -- --json --plan ;;
            status) compadd -- --json --plan ;;
            history) compadd -- --json -n ;;
            report) compadd -- --json ;;
            usage) compadd -- --json --since ;;
            arise) compadd -- --dry-run --force-unlock --from --mode --no-tui --only --parallel --through --until --worktree ;;
            serve) compadd -- --force-unlock --from --mode --only --parallel --through --until --worktree ;;
            done) compadd -- --note ;;
            skip) compadd -- --reason ;;
            reset) compadd -- --force ;;
            notify) compadd -- --event ;;
            config) compadd -- --yes ;;
            adapt) compadd -- --model --plan ;;
            draft) compadd -- --format --model --plan ;;
            update) compadd -- --check --yes ;;
        esac
        return
    fi
    case "$cmd" in
        status) compadd -- ${(f)"$(igris __complete phases 2>/dev/null)"} ;;
        history) compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ;;
        report) compadd -V runs -- ${(f)"$(igris __complete runs 2>/dev/null)"} ;;
        usage) compadd -V runs -- ${(f)"$(igris __complete runs 2>/dev/null)"} ;;
        arise) compadd -- ${(f)"$(igris __complete phases 2>/dev/null)"} ;;
        serve) compadd -- ${(f)"$(igris __complete phases 2>/dev/null)"} ;;
        done) compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ;;
        skip) compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ;;
        reset) compadd -- ${(f)"$(igris __complete tasks 2>/dev/null)"} ;;
        notify) compadd -- test ;;
        config) compadd -- migrate ;;
        draft) compadd -- goal spec import extend ;;
        completion) compadd -- bash zsh fish ;;
    esac
}
if [[ $funcstack[1] == _igris ]]; then
    _igris "$@"
else
    compdef _igris igris
fi
